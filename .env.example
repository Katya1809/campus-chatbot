COLLEGE_NAME=Your College Name
# Optional: comma-separated public pages to scrape (robots.txt is respected)
COLLEGE_URLS=https://www.example-college.edu.in/,https://www.example-college.edu.in/placements
# LLM: gemini | openai   (leave keys empty to run in offline/extractive mode)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
# Embeddings: auto | tfidf | local   (auto uses your API key's provider, else TF-IDF)
EMBEDDINGS=auto
